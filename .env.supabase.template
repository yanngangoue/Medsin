# Copier vers .env :  Copy-Item .env.supabase.template .env
# Puis remplacer [PROJECT-REF], [YOUR-PASSWORD], [REGION] (Supabase → Settings → Database → URI)

# --- Supabase PostgreSQL (Direct connection, port 5432) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?schema=public"

MEDSIM_DEMO_MODE="false"
MEDSIM_PUBLIC_MODE="true"

# Auth NextAuth — openssl rand -base64 32 ou commande PowerShell dans le README
NEXTAUTH_SECRET="REMPLACER_PAR_UN_SECRET_LONG"
NEXTAUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

JWT_SECRET="REMPLACER_PAR_UN_SECRET_LONG_MIN_16_CHARS"

MEDSIM_DEV_PASSWORD_RESET="false"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_ID=""

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_MAX_TOKENS="4096"

MEDSIM_SERVICE_TOKEN=""
MEDSIM_PARTNER_WEBHOOK_SECRET=""
MEDSIM_CRON_SECRET=""
MEDSIM_ENABLE_DEV_INTEROP_PAGE=""
EXPRESS_PORT="4000"
