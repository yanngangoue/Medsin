{
  "name": "medsim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:lan": "next dev -p 3001 -H 0.0.0.0",
    "dev:clean": "node scripts/clean-next.mjs && next dev -p 3001",
    "dev:fresh": "node scripts/clean-next.mjs && next dev -p 3001",
    "free-port": "powershell -ExecutionPolicy Bypass -File scripts/free-port-3001.ps1",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "test:interop": "tsx lib/interop/__tests__/gateway.test.ts",
    "typecheck": "tsc --noEmit",
    "cutout:pens": "python scripts/cutout-pen-images.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@auth/prisma-adapter": "^2.11.2",
    "@clerk/clerk-react": "^5.61.6",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jose": "^6.1.3",
    "next": "15.5.9",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.74.0",
    "stripe": "^18.0.0",
    "zod": "^3.25.46"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.19.25",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
