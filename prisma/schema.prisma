generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  PHARMACIEN
  MEDECIN
  NUTRITIONNISTE
  ADMIN
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  MEDICAL_REVIEW_REQUIRED
}

enum DossierStatus {
  EXCLU_PRE_DIAGNOSTIC
  EN_ATTENTE_MEDECIN
  EN_COURS_REVISION
  INFO_REQUISE
  EN_ATTENTE_CONSULTATION
  APPROUVE
  REFUSE
  ANNULE
}

enum PrescriptionStatus {
  BROUILLON
  ENVOYEE_PATIENT
  ANNULE
}

enum PrescriptionMedication {
  SEMAGLUTIDE
  TIRZEPATIDE
  LIRAGLUTIDE
  OTHER
  NONE
}

enum ClinicalDecisionKind {
  ELIGIBILITY_ELIGIBLE
  ELIGIBILITY_NOT_ELIGIBLE
  ELIGIBILITY_REVIEW_REQUIRED
  PRESCRIPTION_ISSUED
  PRESCRIPTION_DEFERRED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model User {
  id            String    @id @default(uuid())
  prenom        String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? @map("password")
  role          Role      @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  medecinLicenseNumber String?

  questionnaire        Questionnaire?
  refreshTokens        RefreshToken[]
  accounts             Account[]
  sessions             Session[]
  profile              PatientProfile?
  appointments         Appointment[]
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  patientPrivacyConsent      PatientPrivacyConsent?
  metabolicIntakes           MetabolicIntake[]
  metabolicProfileSnapshots  MetabolicProfileSnapshot[]
  dossiersGlp1AsPatient      DossierGlp1[]            @relation("PatientDossiers")
  dossiersGlp1AsMedecin      DossierGlp1[]            @relation("MedecinDossiers")
  prescriptionsAsPatient     Prescription[]           @relation("PatientPrescriptions")
  prescriptionsAsMedecin     Prescription[]           @relation("MedecinPrescriptions")
  messagesSent               Message[]                @relation("MessagesSent")
  messagesReceived           Message[]                @relation("MessagesReceived")
  eligibilityHistoryAsPatient  EligibilityHistory[]     @relation("PatientEligibilityHistory")
  eligibilityHistoryChanged    EligibilityHistory[]     @relation("StaffEligibilityHistory")
  clinicalDecisionsAsPatient   ClinicalDecision[]       @relation("PatientClinicalDecisions")
  clinicalDecisionsMade        ClinicalDecision[]       @relation("StaffClinicalDecisions")

  @@index([role])
}

/** Consentement explicite Loi 25 — données comportement alimentaire / métabolique. */
model PatientPrivacyConsent {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryBehaviorOptIn  Boolean   @default(false)
  dietaryBehaviorVersion String    @default("1.0")
  consentedAt            DateTime?
  updatedAt              DateTime  @updatedAt
}

enum MetabolicIntakeCategory {
  MEAL
  SUPPLEMENT
  SLEEP
  ACTIVITY
  MEDICATION_STATEMENT
  ADVERSE_EFFECT
}

/** Une ressource FHIR normalisée (repas, sommeil, complément, etc.) + analyse IA optionnelle. */
model MetabolicIntake {
  id             String                  @id @default(uuid())
  patientUserId  String
  patient        User                    @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  category       MetabolicIntakeCategory
  fhirResource   Json
  aiAnalysis     Json?
  createdAt      DateTime                @default(now())

  @@index([patientUserId, createdAt])
  @@index([patientUserId, category, createdAt])
}

/** Profil métabolique agrégé (IA) — historique par `computedAt` (tâche 24h). */
model MetabolicProfileSnapshot {
  id                       String   @id @default(uuid())
  patientUserId            String
  patient                  User     @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  nutritionalScore         Float
  metabolicStabilityScore  Float
  adherenceScore           Float
  lifestyleScore           Float
  riskFlags                String[]
  fhirPanelObservation     Json?
  computedAt               DateTime @default(now())

  @@index([patientUserId, computedAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PatientProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String            @default("")
  dateOfBirth    DateTime?
  gender         String?
  healthInfo     Json?

  age            Int
  weightKg       Float
  heightCm       Float
  bmi            Float
  medicalHistory String            @db.Text
  eligibility    EligibilityStatus
  onboardingDone Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  timestamp DateTime @default(now())
  ipAddress String?

  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

model Appointment {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?           @db.Text
  /** Consultation virtuelle GLP-1 (vidéo synchrone ou selon la législation locale). */
  isTeleconsult Boolean         @default(false)
  dossierGlp1Id String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([scheduledAt])
  @@index([dossierGlp1Id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Questionnaire {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  objectif        String
  poids           Float
  taille          Float
  imc             Float
  glpAntecedent   Boolean
  glpLequel       String?
  antecedents     String[]
  medicaments     Boolean
  medicamentsDesc String?
  submittedAt     DateTime @default(now())

  dossiersGlp1 DossierGlp1[]
}

model DossierGlp1 {
  id                   String        @id @default(uuid())
  patientId            String
  patient              User          @relation("PatientDossiers", fields: [patientId], references: [id], onDelete: Cascade)
  questionnaireId      String?
  questionnaire        Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  medecinId            String?
  medecin              User?         @relation("MedecinDossiers", fields: [medecinId], references: [id], onDelete: SetNull)
  status               DossierStatus @default(EN_ATTENTE_MEDECIN)
  healthInfoSnapshot   Json?
  suggestionImc        Float?
  suggestionEligibilite String?      @db.Text
  triageSnapshot       Json?
  notesMedecin         String?       @db.Text
  motifRefus           String?       @db.Text
  decisionDate         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  prescription Prescription?

  @@index([patientId])
  @@index([status])
  @@index([medecinId])
  @@index([createdAt])
}

model Prescription {
  id                    String             @id @default(uuid())
  numeroOrdonnance      String             @unique @default(uuid())
  patientId             String
  patient               User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  medecinId             String
  medecin               User               @relation("MedecinPrescriptions", fields: [medecinId], references: [id], onDelete: Cascade)
  dossierGlp1Id         String             @unique
  dossierGlp1           DossierGlp1        @relation(fields: [dossierGlp1Id], references: [id], onDelete: Cascade)
  medicament            String
  dosage                String
  frequence             String
  duree                 String
  instructions          String             @db.Text
  modeAdministration    String?
  renouvellementAutorise Boolean           @default(false)
  nombreRenouvellements Int                @default(0)
  notesMedicales        String             @db.Text
  status                PrescriptionStatus @default(BROUILLON)
  signatureDate         DateTime?
  signatureMedecin      String?
  pdfUrl                String?            @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([patientId])
  @@index([medecinId])
  @@index([status])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model EligibilityHistory {
  id          String            @id @default(uuid())
  patientId   String
  patient     User              @relation("PatientEligibilityHistory", fields: [patientId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?             @relation("StaffEligibilityHistory", fields: [changedById], references: [id], onDelete: SetNull)
  oldStatus   EligibilityStatus
  newStatus   EligibilityStatus
  note        String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([patientId])
  @@index([createdAt])
}

model ClinicalDecision {
  id              String               @id @default(uuid())
  patientUserId   String
  patient         User                 @relation("PatientClinicalDecisions", fields: [patientUserId], references: [id], onDelete: Cascade)
  decidedByUserId String
  decidedBy       User                 @relation("StaffClinicalDecisions", fields: [decidedByUserId], references: [id], onDelete: Cascade)
  kind            ClinicalDecisionKind
  eligibility     EligibilityStatus
  medication      PrescriptionMedication?
  clinicalNote    String?              @db.Text
  patientMessage  String?              @db.Text
  createdAt       DateTime             @default(now())

  @@index([patientUserId])
  @@index([createdAt])
}
