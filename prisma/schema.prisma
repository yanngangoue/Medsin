generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PATIENT
  PHARMACIEN
  MEDECIN
  NUTRITIONNISTE
  ADMIN
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  MEDICAL_REVIEW_REQUIRED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ClinicalDecisionKind {
  ELIGIBILITY_ELIGIBLE
  ELIGIBILITY_NOT_ELIGIBLE
  ELIGIBILITY_REVIEW_REQUIRED
  PRESCRIPTION_ISSUED
  PRESCRIPTION_DEFERRED
}

enum PrescriptionMedication {
  SEMAGLUTIDE
  TIRZEPATIDE
  LIRAGLUTIDE
  OTHER
  NONE
}

model User {
  id            String    @id @default(uuid())
  prenom        String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? @map("password")
  role          Role      @default(PATIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  questionnaire Questionnaire?
  refreshTokens RefreshToken[]
  accounts      Account[]
  sessions      Session[]
  profile       PatientProfile?
  appointments  Appointment[]
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  patientPrivacyConsent      PatientPrivacyConsent?
  metabolicIntakes           MetabolicIntake[]
  metabolicProfileSnapshots MetabolicProfileSnapshot[]
  messagesSent              Message[] @relation("MessagesSent")
  messagesReceived          Message[] @relation("MessagesReceived")
  clinicalDecisionsAsPatient ClinicalDecision[] @relation("PatientClinicalDecisions")
  clinicalDecisionsAsStaff   ClinicalDecision[] @relation("StaffClinicalDecisions")
  emailLogs                  EmailLog[]

  @@index([role])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, read])
}

/** Consentement explicite Loi 25 — données comportement alimentaire / métabolique. */
model PatientPrivacyConsent {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryBehaviorOptIn  Boolean   @default(false)
  dietaryBehaviorVersion String    @default("1.0")
  consentedAt            DateTime?
  updatedAt              DateTime  @updatedAt
}

enum MetabolicIntakeCategory {
  MEAL
  SUPPLEMENT
  SLEEP
  ACTIVITY
  MEDICATION_STATEMENT
  ADVERSE_EFFECT
}

/** Une ressource FHIR normalisée (repas, sommeil, complément, etc.) + analyse IA optionnelle. */
model MetabolicIntake {
  id             String                  @id @default(uuid())
  patientUserId  String
  patient        User                    @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  category       MetabolicIntakeCategory
  fhirResource   Json
  aiAnalysis     Json?
  createdAt      DateTime                @default(now())

  @@index([patientUserId, createdAt])
  @@index([patientUserId, category, createdAt])
}

/** Profil métabolique agrégé (IA) — historique par `computedAt` (tâche 24h). */
model MetabolicProfileSnapshot {
  id                       String   @id @default(uuid())
  patientUserId            String
  patient                  User     @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  nutritionalScore         Float
  metabolicStabilityScore  Float
  adherenceScore           Float
  lifestyleScore           Float
  riskFlags                String[]
  fhirPanelObservation     Json?
  computedAt               DateTime @default(now())

  @@index([patientUserId, computedAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PatientProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String            @default("")
  dateOfBirth    DateTime?
  gender         String?
  healthInfo     Json?

  age            Int?
  weightKg       Float?
  heightCm       Float?
  bmi            Float?
  medicalHistory String?           @db.Text
  eligibility    EligibilityStatus @default(PENDING)
  onboardingDone Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String?
  timestamp DateTime @default(now())
  ipAddress String?

  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

model Appointment {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([scheduledAt])
}

/** Décision clinique / prescription traçable (qui, quand, quoi). */
model ClinicalDecision {
  id              String                 @id @default(uuid())
  patientUserId   String
  patient         User                   @relation("PatientClinicalDecisions", fields: [patientUserId], references: [id], onDelete: Cascade)
  decidedByUserId String
  decidedBy       User                   @relation("StaffClinicalDecisions", fields: [decidedByUserId], references: [id], onDelete: Cascade)
  kind            ClinicalDecisionKind
  eligibility     EligibilityStatus
  medication      PrescriptionMedication?
  clinicalNote    String?                @db.Text
  patientMessage  String?                @db.Text
  createdAt       DateTime               @default(now())

  @@index([patientUserId, createdAt])
  @@index([decidedByUserId])
}

/** Journal d’envoi e-mails (évite les doublons de rappels). */
model EmailLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  toEmail   String
  template  String
  entityKey String?
  subject   String
  status    String
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([template, entityKey])
  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Questionnaire {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  objectif        String
  poids           Float
  taille          Float
  imc             Float
  glpAntecedent   Boolean
  glpLequel       String?
  antecedents     String[]
  medicaments     Boolean
  medicamentsDesc String?
  submittedAt     DateTime @default(now())
}
