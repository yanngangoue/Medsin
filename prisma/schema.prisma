generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  IPS
  PHARMACIEN
  MEDECIN
  NUTRITIONNISTE
  ADMIN
}

enum EligibilityStatus {
  PENDING
  ELIGIBLE
  NOT_ELIGIBLE
  MEDICAL_REVIEW_REQUIRED
}

enum DossierStatus {
  EXCLU_PRE_DIAGNOSTIC
  EN_ATTENTE_MEDECIN
  EN_COURS_REVISION
  INFO_REQUISE
  EN_ATTENTE_CONSULTATION
  APPROUVE
  REFUSE
  ANNULE
}

enum PrescriptionStatus {
  BROUILLON
  ENVOYEE_PATIENT
  ANNULE
}

enum PrescriptionMedication {
  SEMAGLUTIDE
  TIRZEPATIDE
  LIRAGLUTIDE
  OTHER
  NONE
}

enum ClinicalDecisionKind {
  ELIGIBILITY_ELIGIBLE
  ELIGIBILITY_NOT_ELIGIBLE
  ELIGIBILITY_REVIEW_REQUIRED
  PRESCRIPTION_ISSUED
  PRESCRIPTION_DEFERRED
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum ProgramStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum CheckInFrequency {
  DAILY
  WEEKLY
}

enum ConsultationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PRESCRIPTION_ISSUED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum GlpMessageRole {
  PATIENT
  IPS
  MEDECIN
  AI_COACH
}

enum AnneReportKind {
  CHECK_IN
  WEEKLY
}

enum WeightCheckInStatus {
  PENDING
  COMPLETED
  SKIPPED
  MISSED
}

enum FulfillmentStatus {
  ISSUED
  SENT_TO_PHARMACY
  IN_PREPARATION
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id            String    @id @default(uuid())
  prenom        String
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? @map("password")
  role          Role      @default(PATIENT)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  medecinLicenseNumber String?
  glp1Membership       Glp1Membership?

  questionnaire        Questionnaire?
  refreshTokens        RefreshToken[]
  accounts             Account[]
  sessions             Session[]
  profile              PatientProfile?
  appointments         Appointment[]
  auditLogs            AuditLog[]
  passwordResetTokens  PasswordResetToken[]
  patientPrivacyConsent      PatientPrivacyConsent?
  metabolicIntakes           MetabolicIntake[]
  metabolicProfileSnapshots  MetabolicProfileSnapshot[]
  dossiersGlp1AsPatient      DossierGlp1[]            @relation("PatientDossiers")
  dossiersGlp1AsMedecin      DossierGlp1[]            @relation("MedecinDossiers")
  prescriptionsAsPatient     Prescription[]           @relation("PatientPrescriptions")
  prescriptionsAsMedecin     Prescription[]           @relation("MedecinPrescriptions")
  messagesSent               Message[]                @relation("MessagesSent")
  messagesReceived           Message[]                @relation("MessagesReceived")
  eligibilityHistoryAsPatient  EligibilityHistory[]     @relation("PatientEligibilityHistory")
  eligibilityHistoryChanged    EligibilityHistory[]     @relation("StaffEligibilityHistory")
  clinicalDecisionsAsPatient   ClinicalDecision[]       @relation("PatientClinicalDecisions")
  clinicalDecisionsMade        ClinicalDecision[]       @relation("StaffClinicalDecisions")
  weightProgram                WeightProgram?
  eligibilityChecks            EligibilityCheck[]
  medicalQuestionnaires        MedicalQuestionnaire[]
  medicationFulfillments       MedicationFulfillment[]
  labOrders                    LabOrder[]
  patientChatThreads           ChatThread[]           @relation("PatientThreads")
  professionalChatThreads      ChatThread[]           @relation("ProfessionalThreads")
  chatMessagesSent             ChatMessage[]
  appNotifications             AppNotification[]
  anneReportsAsPatient         AnneIpsReport[]        @relation("AnneReportsPatient")
  anneReportsAsIps             AnneIpsReport[]        @relation("AnneReportsIps")

  pharmacyPartnerId String?
  pharmacyPartner   PharmacyPartner? @relation(fields: [pharmacyPartnerId], references: [id], onDelete: SetNull)

  @@index([role])
  @@index([pharmacyPartnerId])
}

/** Consentement explicite Loi 25 — données comportement alimentaire / métabolique. */
model PatientPrivacyConsent {
  id                     String    @id @default(uuid())
  userId                 String    @unique
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryBehaviorOptIn  Boolean   @default(false)
  dietaryBehaviorVersion String    @default("1.0")
  /** Consentements GLP-1 granulaires (Loi 25) : medical, dataSharing, aiCoach, privacy, marketing */
  glp1Consents           Json?
  consentedAt            DateTime?
  updatedAt              DateTime  @updatedAt
}

enum MetabolicIntakeCategory {
  MEAL
  SUPPLEMENT
  SLEEP
  ACTIVITY
  MEDICATION_STATEMENT
  ADVERSE_EFFECT
}

/** Une ressource FHIR normalisée (repas, sommeil, complément, etc.) + analyse IA optionnelle. */
model MetabolicIntake {
  id             String                  @id @default(uuid())
  patientUserId  String
  patient        User                    @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  category       MetabolicIntakeCategory
  fhirResource   Json
  aiAnalysis     Json?
  createdAt      DateTime                @default(now())

  @@index([patientUserId, createdAt])
  @@index([patientUserId, category, createdAt])
}

/** Profil métabolique agrégé (IA) — historique par `computedAt` (tâche 24h). */
model MetabolicProfileSnapshot {
  id                       String   @id @default(uuid())
  patientUserId            String
  patient                  User     @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  nutritionalScore         Float
  metabolicStabilityScore  Float
  adherenceScore           Float
  lifestyleScore           Float
  riskFlags                String[]
  fhirPanelObservation     Json?
  computedAt               DateTime @default(now())

  @@index([patientUserId, computedAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PatientProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName       String            @default("")
  dateOfBirth    DateTime?
  gender         String?
  healthInfo     Json?

  age            Int
  weightKg       Float
  heightCm       Float
  bmi            Float
  medicalHistory String            @db.Text
  eligibility    EligibilityStatus
  onboardingDone Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entity     String?
  resource   String?
  resourceId String?
  timestamp  DateTime @default(now())
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  @@index([userId])
  @@index([timestamp])
  @@index([action])
}

model Appointment {
  id          String            @id @default(uuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?           @db.Text
  /** Consultation virtuelle GLP-1 (vidéo synchrone ou selon la législation locale). */
  isTeleconsult Boolean         @default(false)
  dossierGlp1Id String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@index([scheduledAt])
  @@index([dossierGlp1Id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Questionnaire {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  objectif        String
  poids           Float
  taille          Float
  imc             Float
  glpAntecedent   Boolean
  glpLequel       String?
  antecedents     String[]
  medicaments     Boolean
  medicamentsDesc String?
  submittedAt     DateTime @default(now())

  dossiersGlp1 DossierGlp1[]
}

model DossierGlp1 {
  id                   String        @id @default(uuid())
  patientId            String
  patient              User          @relation("PatientDossiers", fields: [patientId], references: [id], onDelete: Cascade)
  questionnaireId      String?
  questionnaire        Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  medecinId            String?
  medecin              User?         @relation("MedecinDossiers", fields: [medecinId], references: [id], onDelete: SetNull)
  status               DossierStatus @default(EN_ATTENTE_MEDECIN)
  healthInfoSnapshot   Json?
  suggestionImc        Float?
  suggestionEligibilite String?      @db.Text
  triageSnapshot       Json?
  notesMedecin         String?       @db.Text
  motifRefus           String?       @db.Text
  decisionDate         DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  prescription Prescription?

  @@index([patientId])
  @@index([status])
  @@index([medecinId])
  @@index([createdAt])
}

model Prescription {
  id                    String             @id @default(uuid())
  numeroOrdonnance      String             @unique @default(uuid())
  patientId             String
  patient               User               @relation("PatientPrescriptions", fields: [patientId], references: [id], onDelete: Cascade)
  medecinId             String
  medecin               User               @relation("MedecinPrescriptions", fields: [medecinId], references: [id], onDelete: Cascade)
  dossierGlp1Id         String             @unique
  dossierGlp1           DossierGlp1        @relation(fields: [dossierGlp1Id], references: [id], onDelete: Cascade)
  medicament            String
  dosage                String
  frequence             String
  duree                 String
  instructions          String             @db.Text
  modeAdministration    String?
  renouvellementAutorise Boolean           @default(false)
  nombreRenouvellements Int                @default(0)
  notesMedicales        String             @db.Text
  status                PrescriptionStatus @default(BROUILLON)
  signatureDate         DateTime?
  signatureMedecin      String?
  pdfUrl                String?            @db.Text
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([patientId])
  @@index([medecinId])
  @@index([status])
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model EligibilityHistory {
  id          String            @id @default(uuid())
  patientId   String
  patient     User              @relation("PatientEligibilityHistory", fields: [patientId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   User?             @relation("StaffEligibilityHistory", fields: [changedById], references: [id], onDelete: SetNull)
  oldStatus   EligibilityStatus
  newStatus   EligibilityStatus
  note        String?           @db.Text
  createdAt   DateTime          @default(now())

  @@index([patientId])
  @@index([createdAt])
}

model ClinicalDecision {
  id              String               @id @default(uuid())
  patientUserId   String
  patient         User                 @relation("PatientClinicalDecisions", fields: [patientUserId], references: [id], onDelete: Cascade)
  decidedByUserId String
  decidedBy       User                 @relation("StaffClinicalDecisions", fields: [decidedByUserId], references: [id], onDelete: Cascade)
  kind            ClinicalDecisionKind
  eligibility     EligibilityStatus
  medication      PrescriptionMedication?
  clinicalNote    String?              @db.Text
  patientMessage  String?              @db.Text
  createdAt       DateTime             @default(now())

  @@index([patientUserId])
  @@index([createdAt])
}

/** Abonnement GLP-1 mensuel (paiement avant questionnaire). */
model Glp1Membership {
  id                   String        @id @default(uuid())
  userId               String        @unique
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               PaymentStatus @default(PENDING)
  stripeSubscriptionId String?
  stripeSessionId      String?
  paidAt               DateTime?
  amountCents          Int           @default(14999)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([status])
}

/** Programme de gestion du poids — suivi patient + coach IA. */
model WeightProgram {
  id            String           @id @default(uuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ProgramStatus    @default(ACTIVE)
  startWeight   Float
  targetWeight  Float
  currentWeight Float
  startDate     DateTime         @default(now())
  targetDate    DateTime?
  checkInFreq   CheckInFrequency @default(WEEKLY)
  medication    String?
  currentDose   String?
  isActive      Boolean          @default(true)
  stripeSubId   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  checkIns   WeightCheckIn[]
  aiMessages AiCoachMessage[]

  @@index([userId])
}

model WeightCheckIn {
  id              String              @id @default(uuid())
  programId       String
  program         WeightProgram       @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId          String
  weight          Float
  energie         Int?
  sommeil         Int?
  nausee          Int?
  notes           String?
  sideEffects     Json?
  status          WeightCheckInStatus @default(COMPLETED)
  reminderSentAt  DateTime?
  completedAt     DateTime?
  aiReport        String?             @db.Text
  isEscalation    Boolean             @default(false)
  reportSentToIps Boolean             @default(false)
  reportSentAt    DateTime?
  recordedAt      DateTime            @default(now())

  @@index([programId])
  @@index([userId])
  @@index([recordedAt])
}

model AiCoachMessage {
  id          String        @id @default(uuid())
  programId   String
  program     WeightProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId      String
  role        String
  content     String        @db.Text
  isProactive Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([programId])
  @@index([createdAt])
}

/** Rapports structurés Anne → IPS (check-in ou hebdomadaire). */
model AnneIpsReport {
  id           String         @id @default(uuid())
  userId       String
  ipsId        String
  kind         AnneReportKind @default(CHECK_IN)
  weekNumber   Int?
  content      String         @db.Text
  isEscalation Boolean        @default(false)
  createdAt    DateTime       @default(now())

  user User @relation("AnneReportsPatient", fields: [userId], references: [id], onDelete: Cascade)
  ips  User @relation("AnneReportsIps", fields: [ipsId], references: [id], onDelete: Cascade)

  @@index([ipsId, createdAt])
  @@index([userId, createdAt])
}

// ─── Parcours GLP-1 v2 (Felix-killer) — coexiste avec DossierGlp1 legacy ───

model EligibilityCheck {
  id                        String            @id @default(uuid())
  userId                    String?
  user                      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId                 String
  age                       Int
  bmi                       Float
  hasDiabetes               Boolean
  hasThyroidCancer          Boolean
  hasOtherContraindications Boolean
  status                    EligibilityStatus @default(PENDING)
  createdAt                 DateTime          @default(now())

  @@index([userId])
  @@index([sessionId])
}

model MedicalQuestionnaire {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  height             Float
  weight             Float
  bmi                Float
  targetWeight       Float
  medicalHistory     Json
  currentMedications Json
  allergies          Json
  familyHistory      Json
  hasTried           Boolean
  previousAttempts   String?            @db.Text
  motivations        String             @db.Text
  bloodPressure      String?
  heartRate          Int?
  consentMedical     Boolean
  consentDataSharing Boolean
  consentAiCoach     Boolean
  status             ConsultationStatus @default(DRAFT)
  ipsId              String?
  medecinId          String?
  ipsNotes           String?            @db.Text
  medecinNotes       String?            @db.Text
  reviewedAt         DateTime?
  draftJson          Json?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  medicationFulfillment MedicationFulfillment?
  labOrder              LabOrder?

  @@index([userId])
  @@index([ipsId])
  @@index([status])
}

model PharmacyPartner {
  id          String                  @id @default(uuid())
  name        String
  address     String
  city        String
  province    String
  phone       String
  email       String
  apiEndpoint String?
  apiKey      String?
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  fulfillments MedicationFulfillment[]
  staffUsers  User[]
}

/** Livraison médicament + paiement (distinct de Prescription médicale legacy). */
model MedicationFulfillment {
  id                    String            @id @default(uuid())
  questionnaireId       String            @unique
  questionnaire         MedicalQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipsId                 String
  medication            String
  dosage                String
  duration              Int
  refills               Int               @default(2)
  instructions          String            @db.Text
  pdfUrl                String?
  pdfGeneratedAt        DateTime?
  paymentStatus         PaymentStatus     @default(PENDING)
  stripeSessionId       String?
  stripePaymentIntentId String?
  paidAt                DateTime?
  amountCents           Int               @default(0)
  status                FulfillmentStatus @default(ISSUED)
  pharmacyId            String?
  pharmacy              PharmacyPartner?  @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  trackingNumber        String?
  trackingUrl           String?
  shippedAt             DateTime?
  estimatedDelivery     DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  statusHistory FulfillmentStatusHistory[]

  @@index([userId])
  @@index([status])
}

model FulfillmentStatusHistory {
  id            String              @id @default(uuid())
  fulfillmentId String
  fulfillment   MedicationFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  status        FulfillmentStatus
  note          String?
  createdAt     DateTime            @default(now())

  @@index([fulfillmentId])
}

model LabOrder {
  id              String               @id @default(uuid())
  questionnaireId String               @unique
  questionnaire   MedicalQuestionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  userId          String
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tests           Json
  labName         String?
  status          String               @default("ORDERED")
  resultUrl       String?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
}

model ChatThread {
  id             String        @id @default(uuid())
  patientId      String
  patient        User          @relation("PatientThreads", fields: [patientId], references: [id], onDelete: Cascade)
  professionalId String
  professional   User          @relation("ProfessionalThreads", fields: [professionalId], references: [id], onDelete: Cascade)
  subject        String
  isActive       Boolean       @default(true)
  isUrgent       Boolean       @default(false)
  messages       ChatMessage[]
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())

  @@index([patientId])
  @@index([professionalId])
  @@index([isUrgent])
}

model ChatMessage {
  id            String          @id @default(uuid())
  threadId      String
  thread        ChatThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  role          GlpMessageRole
  content       String          @db.Text
  isRead        Boolean         @default(false)
  readAt        DateTime?
  attachmentUrl String?
  attachmentId  String?         @unique
  attachment    ChatAttachment? @relation(fields: [attachmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@index([threadId])
  @@index([senderId])
}

/** Pièce jointe clavardage (PDF labo, etc.) — contenu chiffré at-rest. */
model ChatAttachment {
  id         String       @id @default(uuid())
  threadId   String
  uploaderId String
  fileName   String
  mimeType   String       @default("application/pdf")
  contentEnc String       @db.Text
  createdAt  DateTime     @default(now())
  message    ChatMessage?

  @@index([threadId])
}

model AppNotification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String   @db.Text
  isRead      Boolean  @default(false)
  sentByEmail Boolean  @default(false)
  sentBySms   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

/** Journal des envois transactionnels (idempotence Resend). */
model EmailLog {
  id        String   @id @default(uuid())
  userId    String?
  toEmail   String
  template  String
  entityKey String?
  subject   String
  status    String
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([template, entityKey], name: "template_entityKey")
  @@index([userId])
}

/** Audit actions médecin sur dossiers patients. */
model AuditMedical {
  id        String   @id @default(uuid())
  medecinId String
  patientId String
  action    String
  details   Json
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  @@index([medecinId])
  @@index([patientId])
}
