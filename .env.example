# Sans PostgreSQL : inscription, questionnaire et connexion en mémoire (effacé au redémarrage du serveur).
MEDSIM_DEMO_MODE="false"

# PostgreSQL (Prisma) — ignoré tant que MEDSIM_DEMO_MODE=true
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/medsim?schema=public"
# Avec Docker : `docker compose up -d` puis par ex.
# DATABASE_URL="postgresql://medsim:medsim@localhost:5432/medsim?schema=public"

# JWT secret — generate a long random string for production
JWT_SECRET="change-me-to-a-long-random-secret"

# NextAuth (Auth.js v5) — secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
# Doit correspondre au port de `npm run dev` (fixé à 3001 dans package.json)
NEXTAUTH_URL="http://localhost:3001"

# Stripe (Checkout)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID="price_..."

# App URL for Stripe redirects
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Express API (optionnel — même DATABASE_URL et JWT_SECRET)
EXPRESS_PORT="4000"

# Anthropic (Claude) — serveur uniquement, ne pas préfixer par NEXT_PUBLIC_
ANTHROPIC_API_KEY=""
# Optionnel — voir https://docs.anthropic.com/claude/docs/models-overview
ANTHROPIC_MODEL="claude-sonnet-4-20250514"
ANTHROPIC_MAX_TOKENS="4096"
